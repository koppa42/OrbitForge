    ENGINEERING: ReportUnits

class ReportTimeScale:
    UTC: ReportTimeScale
    TAI: ReportTimeScale
    TT: ReportTimeScale

class ReportScope:
    OBJECTS: ReportScope
    ALL_COMPATIBLE: ReportScope

class ReportQuery:
    def __init__(self) -> None: ...
    kind: ReportKind
    scope: ReportScope
    object_ids: list[str]
    follow_scenario: bool
    first: Epoch
    last: Epoch
    step_nanoseconds: int
    frame: FrameId

class ReportColumnSpec:
    def __init__(self, field: str, unit: str = "", title: str = "") -> None: ...
    field: str
    unit: str
    title: str

class ReportTemplate:
    def __init__(self) -> None: ...
    columns: list[ReportColumnSpec]
    units: ReportUnits
    time_scale: ReportTimeScale

class ReportDefinition:
    def __init__(self) -> None: ...
    id: str
    name: str
    query: ReportQuery
    format: ReportTemplate

def report_columns(kind: ReportKind) -> list[ReportColumn]: ...

class ReportColumn:
    @property
    def id(self) -> str: ...
    @property
    def title(self) -> str: ...
    @property
    def unit(self) -> str: ...

class ReportTable:
    @property
    def columns(self) -> list[ReportColumn]: ...
    @property
    def rows(self) -> list[list[str | int | float | Epoch | None]]: ...
    @property
    def row_count(self) -> int: ...

class ReportResult:
    @property
    def input_revision(self) -> int: ...
    @property
    def definition(self) -> ReportDefinition: ...
    @property
    def table(self) -> ReportTable: ...
    @property
    def input_sha256(self) -> str: ...
    @property
    def data_sha256(self) -> str: ...
    @property
    def time_sha256(self) -> str: ...
    @property
    def algorithm(self) -> str: ...
    @property
    def first(self) -> Epoch: ...
    @property
    def last(self) -> Epoch: ...
    def with_template(self, format: ReportTemplate) -> ReportResult: ...
    def column_title(self, column: int) -> str: ...
    def column_unit(self, column: int) -> str: ...
    def numeric_value(self, row: int, column: int) -> float | None: ...
    def cell_text(self, row: int, column: int) -> str: ...
    def export_csv(self, path: str | PathLike[str], overwrite: bool = False) -> None: ...

def estimate_report_rows(project: Project, definition: ReportDefinition) -> int: ...
def report_input_sha256(project: Project) -> str: ...
def generate_report(project: Project, definition: ReportDefinition,
                    eop_manifest: str | PathLike[str] | None = None,
                    time_file: str | PathLike[str] | None = None) -> ReportResult: ...

class OrbitInterpolationMethod:
    LAGRANGE: OrbitInterpolationMethod
    HERMITE: OrbitInterpolationMethod
    VOP: OrbitInterpolationMethod
    @property
    def name(self) -> str: ...

class OrbitInterpolationOptions:
    def __init__(self) -> None: ...
    method: OrbitInterpolationMethod
    order: int
    vop_mu: float

def make_tabulated_orbit_session(
    arcs: Sequence[Sequence[CartesianState]],
    options: OrbitInterpolationOptions = ...,
    object_id: str = "satellite-1",
    input_revision: int = 1,
) -> Session: ...

def propagate_hpop_ephemeris(
    input: OrbitInput, end: Epoch, *, reporting_step_nanoseconds: int = 0,
    data: DataSnapshot = ..., cancelled: Callable[[], bool] | None = None,
) -> list[list[CartesianState]]: ...

def make_hpop_ephemeris_session(
    input: OrbitInput, end: Epoch, interpolation: OrbitInterpolationOptions, *,
    reporting_step_nanoseconds: int = 0, data: DataSnapshot = ...,
    input_revision: int = 1, cancelled: Callable[[], bool] | None = None,
) -> Session: ...
